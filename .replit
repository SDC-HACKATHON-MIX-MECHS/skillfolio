modules = ["python-3.12"]
run = "streamlit run app/Home.py --server.port 8501 --server.address 0.0.0.0 --server.headless true"

[deployment]
run = ["sh", "-c", "streamlit run app/Home.py --server.port 8501 --server.address 0.0.0.0 --server.headless true"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8501
externalPort = 80
